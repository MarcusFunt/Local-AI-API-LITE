# Public Apache-2.0 Qwen3.5-4B W4A16 checkpoint, pinned to this Hub revision.
MODEL_ID=RedHatAI/Qwen3.5-4B-quantized.w4a16
MODEL_REVISION=7a613872f394578b0b52b683ff4ac47516b4bcaf
MODEL_ALIAS=ddu-narrator

# Start with the tested conservative profile. Increase only after host profiling.
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.75
REASONING_PARSER=qwen3

# Absolute path to the persistent Hugging Face cache, outside this repository.
# Windows example: C:/Users/your-name/.cache/huggingface
# WSL example: /mnt/c/Users/your-name/.cache/huggingface
HF_CACHE_DIR=C:/Users/your-name/.cache/huggingface
